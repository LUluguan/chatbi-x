# 复制为 .env 后按需修改。所有变量以 CHATBI_ 为前缀。
# 默认 provider=mock（零配置可跑通演示与评测），接真实模型改为 openai_compat。

CHATBI_LLM_PROVIDER=openai_compat

# DeepSeek
CHATBI_LLM_BASE_URL=https://api.deepseek.com/v1
CHATBI_LLM_API_KEY=sk-xxx
CHATBI_LLM_MODEL=deepseek-chat

# 本地 Ollama 示例:
# CHATBI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHATBI_LLM_MODEL=qwen2.5-coder:7b
# CHATBI_LLM_API_KEY=ollama

CHATBI_DB_PATH=data/demo_ecom.db
CHATBI_MAX_AGENT_STEPS=6
CHATBI_MAX_ROWS=50

# Docker 部署时由 API 托管前端产物（镜像内已配置，无需手动设置）
# CHATBI_WEB_DIST=/app/web/dist
